{
    "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.29/MicrosoftTeams.schema.json",
    "manifestVersion": "1.29",
    "version": "1.0.0",
    "id": "${{TEAMS_APP_ID}}",
    "developer": {
        "name": "My App, Inc.",
        "websiteUrl": "https://www.example.com",
        "privacyUrl": "https://www.example.com/privacy",
        "termsOfUseUrl": "https://www.example.com/termofuse"
    },
    "icons": {
        "color": "color.png",
        "outline": "outline.png"
    },
    "name": {
        "short": "Drilling Hotspots Agent${{APP_NAME_SUFFIX}}",
        "full": "Drilling Hotspots Agent"
    },
    "description": {
        "short": "Operational piloting for a drilling-well fleet on an interactive map.",
        "full": "Drilling Hotspots Agent helps oil & gas teams pilot a fleet of drilling wells across worldwide basins: an interactive map of the wells with status-coloured markers, operational KPIs (production, wellhead pressure, depth, water cut), fleet summaries, and operational hotspots (wells with active alerts). Well data is served through an MCP server."
    },
    "accentColor": "#FFFFFF",
    "supportsChannelFeatures": "tier1",
    "composeExtensions": [],
    "permissions": [
        "identity",
        "messageTeamMembers"
    ],
    "copilotAgents": {
        "declarativeAgents": [            
            {
                "id": "declarativeAgent",
                "file": "declarativeAgent.json"
            }
        ]
    },
    "validDomains": [
        "1wsvgmch-8010.uks1.devtunnels.ms",
        "0g5b8whl-8011.uks1.devtunnels.ms",
        "m11q5trv-8012.uks1.devtunnels.ms"
    ]
}